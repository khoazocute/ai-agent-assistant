# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit .env.

# --- LLM (bước 1) — lấy key tại https://aistudio.google.com/apikey ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Ứng dụng ---
APP_TIMEZONE=Asia/Ho_Chi_Minh
DATABASE_URL=sqlite:///backend/data/app.db

# --- Telegram (bước 12) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# --- Google OAuth: Gmail + Calendar (bước 10, 15) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Bảo mật (bước 10–13) ---
JWT_SECRET=
FERNET_KEY=

# --- Giọng nói (bước 18) ---
WHISPER_MODEL=medium
