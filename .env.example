# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit .env.

# --- LLM (bước 1) — lấy key tại https://aistudio.google.com/apikey ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Ứng dụng ---
APP_TIMEZONE=Asia/Ho_Chi_Minh
DATABASE_URL=sqlite:///backend/data/app.db
# docker compose dùng PostgreSQL — đặt mật khẩu DB:
POSTGRES_PASSWORD=

# --- Telegram (bước 12) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Agent trả lời Telegram/web: supervisor (multi-agent) | single (ADR-0008)
DEFAULT_AGENT=supervisor
# off | polling (bot chạy chung tiến trình web → Telegram cập nhật web realtime)
TELEGRAM_MODE=off
# chỉ cho TELEGRAM_MODE=webhook: https://ten-mien-cua-ban
PUBLIC_BASE_URL=
# job nền: bản tin 7h/21h, nhắc lịch, đồng bộ Google, dọn trace
JOBS_ENABLED=true

# --- Google OAuth: Gmail + Calendar (bước 10, 15) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Bảo mật (bước 10–13) ---
# Website: mật khẩu đăng nhập + khoá ký phiên (≥ 32 ký tự ngẫu nhiên)
WEB_PASSWORD=
JWT_SECRET=
# true khi chạy sau HTTPS (production)
COOKIE_SECURE=false
FERNET_KEY=

# --- Giọng nói (bước 18) ---
# tiny | small | medium — tiếng Việt nên dùng small trở lên (pip install -e "backend[voice]")
WHISPER_MODEL=small
